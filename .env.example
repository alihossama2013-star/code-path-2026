# GEMINI_API_KEY: Required for server-side Gemini HD TTS calls (/api/tts).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this app is hosted (optional on Vercel; auto-detected if omitted).
APP_URL="MY_APP_URL"

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized Redirect URI: <YOUR_APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Vercel KV / Upstash Redis REST credentials for cross-device progress sync on Vercel
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
